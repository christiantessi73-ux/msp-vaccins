# En-têtes servis par Cloudflare Pages (fichier lu comme configuration,
# jamais servi aux visiteurs). GitHub Pages l'ignore : sans effet tant que
# la bascule n'est pas faite.

/*
  # Le questionnaire n'a pas vocation à remonter dans les moteurs : on y
  # arrive par le QR code du comptoir. Double emploi avec robots.txt, qui
  # lui n'est qu'une consigne aux robots polis.
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
