# Configuration Apache de l'hébergement OVH.
#
# Chaque bloc est protégé par un IfModule : si le module n'est pas chargé,
# Apache ignore les directives au lieu de renvoyer une erreur 500 sur tout
# le site. Sur un hébergement mutualisé, on ne choisit pas ce qui est actif.

# ---- Sonde temporaire ----
# ErrorDocument est une directive du coeur d'Apache : elle ne dépend
# d'aucun module. Si ce texte apparaît sur une page inexistante, le
# fichier est lu ; sinon, l'hébergement ignore les .htaccess.
ErrorDocument 404 "sonde-htaccess-active"

# ---- Tout le monde en HTTPS ----
# Le site servait encore en clair à qui tapait l'adresse sans « https ».
# La double condition évite la boucle de redirection : on ne redirige que
# si aucun des deux indicateurs de TLS n'est présent.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- En-têtes ----
# Repris du fichier _headers préparé pour Cloudflare, devenu sans objet.
<IfModule mod_headers.c>
    # On arrive ici par le QR code du comptoir, pas par une recherche.
    Header set X-Robots-Tag "noindex"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Page d'accueil ----
<IfModule mod_dir.c>
    DirectoryIndex index.html
</IfModule>
